# ============================================================
# DzenPilot — пример переменных окружения
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
# Файл .env в репозиторий не попадает (см. .gitignore).
# ============================================================

# ---------- Общее ----------
APP_ENV=development
APP_DEBUG=true
APP_NAME=DzenPilot

# ---------- База данных ----------
POSTGRES_USER=dzenpilot
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=dzenpilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Строка подключения собирается автоматически, но её можно переопределить:
# DATABASE_URL=postgresql+asyncpg://dzenpilot:change_me_postgres@postgres:5432/dzenpilot

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------- Безопасность ----------
# Секрет для подписи JWT. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace_me_with_a_long_random_string

# Ключ шифрования API-ключей интеграций (Fernet, 32 байта в base64). Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=replace_me_with_a_fernet_key

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3000

# ---------- Ограничение частоты запросов ----------
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20

# ---------- ИИ ----------
# Основной провайдер: anthropic | openai | gemini | local
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=claude-sonnet-5

# Глобальный ключ по умолчанию. Можно оставить пустым и ввести ключ
# в разделе «Интеграции» — он сохранится в базе в зашифрованном виде.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LOCAL_AI_BASE_URL=

# ---------- Тестовые данные ----------
SEED_DEMO_DATA=true
SEED_USER_EMAIL=demo@dzenpilot.ru
SEED_USER_PASSWORD=demo12345

# ---------- Frontend ----------
# Адрес backend, который видит браузер.
# Для разработки: http://localhost:8000
# Для сервера: оставьте пустым — запросы идут через тот же домен (Caddy)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Адрес backend изнутри docker-сети (для серверных компонентов Next.js)
INTERNAL_API_URL=http://backend:8000

# ---------- Боевой сервер ----------
# ":80"          — работа по IP-адресу без сертификата
# "example.ru"   — Caddy сам получит сертификат Let's Encrypt
SITE_ADDRESS=:80
